{
  "name": "@stencil/storybook-plugin",
  "version": "1.0.0",
  "description": "Storybook plugin for Stencil",
  "license": "MIT",
  "homepage": "https://github.com/stenciljs/storybook",
  "bugs": {
    "url": "https://github.com/stenciljs/storybook"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/storybook.git",
    "directory": "packages/plugin"
  },
  "keywords": [
    "storybook",
    "stencil",
    "stenciljs",
    "webcomponents",
    "components",
    "framework"
  ],
  "type": "module",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "template",
    "@types",
    "preset.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./preview": {
      "types": "./dist/entry-preview.d.mts",
      "import": "./dist/entry-preview.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./wizard": {
      "types": "./dist/wizard.d.mts",
      "import": "./dist/wizard.mjs"
    },
    "./package.json": "./package.json"
  },
  "stencil": {
    "wizard": "./dist/wizard.mjs"
  },
  "scripts": {
    "watch": "tsdown --watch",
    "build": "tsdown"
  },
  "dependencies": {
    "@stencil/unplugin": "^5.0.0 || >=5.0.0-alpha.19 <5.0.0-next.0",
    "@storybook/builder-vite": "^10.4.6",
    "@storybook/global": "^5.0.0",
    "@storybook/html": "^10.4.6",
    "preact-render-to-string": "^6.7.0",
    "react-docgen-typescript": "^2.4.0"
  },
  "peerDependencies": {
    "@stencil/core": "catalog:",
    "storybook": "^10.0.0"
  },
  "devDependencies": {
    "@stencil/cli": "catalog:",
    "@stencil/core": "catalog:",
    "@types/node": "^26.1.0",
    "custom-elements-manifest": "^2.1.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
